# ──────────────────────────────────────────────────────────
# TubeToMD Backend — Environment Variables
# Copy this file to .env and fill in your values
# ──────────────────────────────────────────────────────────

# Server
PORT=5000

# Database
MONGODB_URI=mongodb+srv://your-user:your-password@cluster.mongodb.net/TubeToMD

# JWT Auth
JWT_SECRET=your-jwt-secret-change-in-production
JWT_REFRESH_SECRET=your-refresh-secret-change-in-production
JWT_EXPIRY=1d
JWT_REFRESH_EXPIRY=7d

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/google/callback

# NVIDIA NIM AI (free keys at https://build.nvidia.com — mobile OTP required)
NVIDIA_API_KEY=your-primary-nvidia-nim-key
NVIDIA_API_KEYS=key1,key2,key3                 # Optional rotation pool (max 2-3 keys realistic)

# Optional model overrides
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# NVIDIA_IMAGE_BASE_URL=https://ai.api.nvidia.com/v1
# NVIDIA_MODEL_QUALITY=meta/llama-3.3-70b-instruct
# NVIDIA_MODEL_QUALITY_FALLBACK=nvidia/llama-3.1-nemotron-70b-instruct
# NVIDIA_MODEL_FAST=meta/llama-3.1-8b-instruct
# NVIDIA_MODEL_FAST_FALLBACK=mistralai/mistral-small-24b-instruct
# NVIDIA_MODEL_IMAGE=black-forest-labs/flux.1-schnell
# NVIDIA_MODEL_IMAGE_FALLBACK=stabilityai/stable-diffusion-3-medium

# Per-user daily image generation quota
IMAGE_GEN_DAILY_QUOTA_PER_USER=5

# Admin
ADMIN_API_TOKEN=your-admin-secret-token     # Bearer token for /api/v1/admin/* endpoints

# Services
PYTHON_SERVICE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

# Uploads
UPLOAD_DIR=./uploads
# Maximum allowed duration for uploaded videos in seconds (e.g., 1800 = 30 minutes)
MAX_VIDEO_DURATION_SECONDS=1800
