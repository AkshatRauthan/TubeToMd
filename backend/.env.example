# Server
PORT=5000

# Database
MONGODB_URI=mongodb+srv://your-user:your-password@cluster.mongodb.net/TubeToMD

# JWT Auth
JWT_SECRET=your-jwt-secret-change-in-production
JWT_REFRESH_SECRET=your-refresh-secret-change-in-production
JWT_EXPIRY=1d
JWT_REFRESH_EXPIRY=7d

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/google/callback

# Groq AI (get free key at https://console.groq.com/keys)
GROQ_API_KEY=your-groq-api-key
GROQ_API_KEYS=key1,key2,key3              # Optional: comma-separated additional keys for rotation pool

# Admin
ADMIN_API_TOKEN=your-admin-secret-token     # Bearer token for /api/v1/admin/* endpoints

# Services
PYTHON_SERVICE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

# Uploads
UPLOAD_DIR=./uploads