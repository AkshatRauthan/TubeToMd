# ──────────────────────────────────────────────────────────────
# TubeToMD Backend — HuggingFace Spaces Dockerfile
# ──────────────────────────────────────────────────────────────
# Deploy as standalone HF Space (Docker SDK, port 7860)
#
# Setup:
#   1. Create HF Space with Docker SDK
#   2. Copy this file as "Dockerfile" in the Space repo
#   3. Copy the backend/ directory contents alongside it
#   4. Set secrets in HF Space settings (see below)
#
# Required HF Space Secrets:
#   MONGODB_URI, JWT_SECRET, JWT_REFRESH_SECRET,
#   NVIDIA_API_KEY, NVIDIA_API_KEYS (optional),
#   GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET,
#   ADMIN_API_TOKEN, PYTHON_SERVICE_URL, FRONTEND_URL
# ──────────────────────────────────────────────────────────────

FROM node:20-alpine AS builder

WORKDIR /app

COPY package*.json ./
RUN npm ci

COPY . .
RUN npm run build

FROM node:20-alpine

WORKDIR /app

RUN mkdir -p /app/uploads

COPY package*.json ./
RUN npm ci --omit=dev && npm cache clean --force

COPY --from=builder /app/dist ./dist

# HuggingFace requires port 7860
ENV PORT=7860
EXPOSE 7860

CMD ["node", "dist/index.js"]
