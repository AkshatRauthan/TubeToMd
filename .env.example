# ──────────────────────────────────────────────────────────
# TubeToMD Consolidated Environment Variables (Docker)
# Copy this file to .env in the root directory
# ──────────────────────────────────────────────────────────

# --- DATABASE SECTIONS ---
# MongoDB Atlas Connection String (Required)
# Example: mongodb+srv://user:pass@cluster.mongodb.net/TubeToMD
MONGODB_URI=your-mongodb-atlas-uri-here

# --- AUTH SECTIONS ---
# JWT Secrets (Generate random strings for these)
JWT_SECRET=your-jwt-secret-change-in-production
JWT_REFRESH_SECRET=your-refresh-secret-change-in-production

# Google OAuth (Required for Google Login)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# --- AI SECTIONS (NVIDIA NIM) ---
# Get free keys at https://build.nvidia.com (mobile OTP required, ~1000 free credits/key)
NVIDIA_API_KEY=your-primary-nvidia-nim-key
NVIDIA_API_KEYS=key1,key2,key3                 # Optional: comma-separated rotation pool

# Optional model overrides (defaults are sensible)
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# NVIDIA_IMAGE_BASE_URL=https://ai.api.nvidia.com/v1
# NVIDIA_MODEL_QUALITY=meta/llama-3.3-70b-instruct
# NVIDIA_MODEL_QUALITY_FALLBACK=nvidia/llama-3.1-nemotron-70b-instruct
# NVIDIA_MODEL_FAST=meta/llama-3.1-8b-instruct
# NVIDIA_MODEL_FAST_FALLBACK=mistralai/mistral-small-24b-instruct
# NVIDIA_MODEL_IMAGE=black-forest-labs/flux.1-schnell
# NVIDIA_MODEL_IMAGE_FALLBACK=stabilityai/stable-diffusion-3-medium

# Per-user daily image generation quota (set to 0 to disable cap)
IMAGE_GEN_DAILY_QUOTA_PER_USER=5

# --- TRANSCRIPTION (Groq Whisper — kept separate, not migrated to NIM) ---
# Get free key at https://console.groq.com/keys
# Free tier: 20 RPM / 2,000 RPD / 28,800 audio seconds per day
# IMPORTANT: Limits are org-level — multiple keys do NOT multiply quota
GROQ_API_KEY=your-groq-key-for-whisper-only

# --- ADMIN SECTIONS ---
# Admin access token for protected endpoints
ADMIN_API_TOKEN=your-admin-secret-token
