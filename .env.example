# ──────────────────────────────────────────────────────────
# TubeToMD Consolidated Environment Variables (Docker)
# Copy this file to .env in the root directory
# ──────────────────────────────────────────────────────────

# --- DATABASE SECTIONS ---
# MongoDB Atlas Connection String (Required)
# Example: mongodb+srv://user:pass@cluster.mongodb.net/TubeToMD
MONGODB_URI=your-mongodb-atlas-uri-here

# --- AUTH SECTIONS ---
# JWT Secrets (Generate random strings for these)
JWT_SECRET=your-jwt-secret-change-in-production
JWT_REFRESH_SECRET=your-refresh-secret-change-in-production

# Google OAuth (Required for Google Login)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# --- AI SECTIONS ---
# Groq AI Service (Get keys at https://console.groq.com/keys)
GROQ_API_KEY=your-primary-groq-key
GROQ_API_KEYS=key1,key2,key3 # Optional: multiple keys for rotation pool

# --- ADMIN SECTIONS ---
# Admin access token for protected endpoints
ADMIN_API_TOKEN=your-admin-secret-token
