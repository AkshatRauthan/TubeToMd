# Server
PORT=8000

# Whisper Transcription
WHISPER_MODEL=base                          # Options: base, small, medium, large-v3
MAX_FILE_SIZE_MB=512

# Uploads
UPLOAD_DIR=./uploads

# Database (if needed for Python-side features)
MONGODB_URI=mongodb+srv://your-user:your-password@cluster.mongodb.net/TubeToMD

# Gemini (if needed for Python-side features)
GEMINI_API_KEY=your-gemini-api-key

# Google OAuth (if needed)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret