# Server
PORT=8000

# Groq AI (get free key at https://console.groq.com/keys)
GROQ_API_KEY=your-groq-api-key
MAX_FILE_SIZE_MB=512

# Uploads
UPLOAD_DIR=./uploads

# Database (if needed for Python-side features)
MONGODB_URI=mongodb+srv://your-user:your-password@cluster.mongodb.net/TubeToMD

# Google OAuth (if needed)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret