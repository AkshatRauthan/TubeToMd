# ──────────────────────────────────────────────────────────
# TubeToMD Python Service — Environment Variables
# Copy this file to .env and fill in your values
# ──────────────────────────────────────────────────────────

# Server
PORT=8000

# Groq AI — Used for Whisper transcription (get free key at https://console.groq.com/keys)
# Free tier: 20 RPM / 2,000 RPD / 28,800 audio seconds per day
# IMPORTANT: Limits are org-level — multiple keys do NOT multiply quota
GROQ_API_KEY=your-groq-api-key
GROQ_API_KEYS=key-from-account2,key-from-account3   # Optional: comma-separated, add as many keys as you want (no limit)

# File Upload Limits
MAX_FILE_SIZE_MB=500

# Uploads directory (audio/video chunks)
UPLOAD_DIR=./uploads

# Database (used for direct session updates if needed)
MONGODB_URI=mongodb+srv://your-user:your-password@cluster.mongodb.net/TubeToMD

# Google OAuth (if needed for Python-side features)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret